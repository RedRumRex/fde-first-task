# Copy to .env and fill in. .env is git-ignored, so keys never go in the repo.
GROQ_API_KEY=
TAVILY_API_KEY=

# ---- Optional overrides ----
# LLM_PROVIDER=groq                         # or "openai": then also set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=
# Models are picked automatically from what your key can access (python run.py --models). Set one to pin it.
# MODEL=openai/gpt-oss-120b                 # drafter, and the Day-1 single agent
# RESEARCHER_MODEL=openai/gpt-oss-20b       # tool-calling research loop
# CHECKER_MODEL=openai/gpt-oss-20b          # must differ from the drafter (qwen returned empty verdicts)
# REPORTER_MODEL=openai/gpt-oss-20b
# JUDGE_MODEL=openai/gpt-oss-120b           # eval only: never the checker's model
# MAX_RETRIES=2                             # rewrites after the first draft (so max 3 drafts)

# Groq free tier is about 8K tokens/minute per model. These keep every call under it:
# TPM_LIMIT=7500                            # client-side pacing per model; raise it on a paid Groq plan
# MAX_SOURCE_CHARS=3000                     # characters of each source sent to the models
# REASONING_EFFORT=low                      # gpt-oss hidden reasoning (counts against the limit)
